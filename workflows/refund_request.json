{
  "$schema": "../schemas/workflow.schema.json",
  "id": "refund_request",
  "version": 1,
  "description": "End-to-end refund intake, identity verification, assessment, channel routing, and submission.",
  "mutable_inputs": {
    "charge_date": {"type": "string", "on_change": "find_order", "priority": 10, "invalidates": ["order", "order_lookup", "refund_facts", "refund_facts_loaded", "refund_eligibility", "refund_reason", "eligibility_result"]},
    "amount": {"type": "number", "on_change": "find_order", "priority": 10, "invalidates": ["order", "order_lookup", "refund_facts", "refund_facts_loaded", "refund_eligibility", "refund_reason", "eligibility_result"]},
    "purchase_channel_hint": {"type": "string", "on_change": "find_order", "priority": 10, "invalidates": ["order", "order_lookup", "refund_facts", "refund_facts_loaded", "refund_eligibility", "refund_reason", "eligibility_result"]},
    "account_relation": {"type": "string", "enum": ["current", "other"], "on_change": "account_scope", "priority": 0, "invalidates": ["target_account_verified", "account_binding", "identity_result", "order", "order_lookup", "refund_facts", "refund_facts_loaded", "refund_eligibility", "refund_reason", "eligibility_result"]},
    "purchase_account_phone": {"type": "string", "on_change": "send_otp", "priority": 0, "invalidates": ["target_account_verified", "account_binding", "identity_result", "order", "order_lookup", "refund_facts", "refund_facts_loaded", "refund_eligibility", "refund_reason", "eligibility_result"]}
  },
  "start": "collect_order_clues",
  "nodes": {
    "collect_order_clues": {
      "type": "ask",
      "collect": ["charge_date", "amount", "purchase_channel_hint", "account_relation"],
      "prompt": "请提供扣款日期、金额、购买渠道（如果知道），以及订单属于当前账号还是其他账号。",
      "next": "account_scope"
    },
    "account_scope": {
      "type": "branch",
      "cases": [
        {"when": "account_relation == 'current'", "next": "bind_current_account"}
      ],
      "default": "ask_purchase_phone"
    },
    "bind_current_account": {
      "type": "action",
      "tool": "bind_current_account",
      "args": {},
      "requires": ["session.authenticated"],
      "on_guard_failure": "ask_purchase_phone",
      "result_statuses": ["bound", "error"],
      "transitions": {"bound": "find_order", "error": "escalate"},
      "save_result_as": "account_binding"
    },
    "ask_purchase_phone": {
      "type": "ask",
      "collect": ["purchase_account_phone"],
      "prompt": "请提供购买账号绑定的手机号，我会发送验证码验证账号归属。",
      "next": "send_otp",
      "max_visits": 3,
      "on_limit": "escalate"
    },
    "send_otp": {
      "type": "action",
      "tool": "send_otp",
      "args": {"phone": "{{ purchase_account_phone }}"},
      "requires": ["purchase_account_phone"],
      "on_guard_failure": "ask_purchase_phone",
      "result_statuses": ["sent", "rate_limited", "error"],
      "transitions": {"sent": "ask_otp", "rate_limited": "escalate", "error": "escalate"}
    },
    "ask_otp": {
      "type": "ask",
      "collect": ["otp_code"],
      "sensitive_collect": ["otp_code"],
      "prompt": "验证码已发送，请在安全输入区域输入验证码。",
      "next": "verify_otp",
      "max_visits": 3,
      "on_limit": "escalate"
    },
    "verify_otp": {
      "type": "action",
      "tool": "verify_otp",
      "args": {"phone": "{{ purchase_account_phone }}", "code": "{{ otp_code }}"},
      "requires": ["purchase_account_phone", "otp_code"],
      "on_guard_failure": "ask_otp",
      "result_statuses": ["verified", "failed", "expired", "error"],
      "transitions": {"verified": "find_order", "failed": "ask_otp", "expired": "ask_otp", "error": "escalate"},
      "save_result_as": "identity_result",
      "consume_facts": ["otp_code"]
    },
    "find_order": {
      "type": "action",
      "tool": "find_order",
      "args": {"charge_date": "{{ charge_date }}", "amount": "{{ amount }}", "phone": "{{ purchase_account_phone }}"},
      "requires": ["target_account_verified"],
      "on_guard_failure": "verify_otp",
      "result_statuses": ["found", "not_found", "error"],
      "transitions": {"found": "route_by_channel", "not_found": "ask_order_clue", "error": "escalate"},
      "save_result_as": "order_lookup"
    },
    "ask_order_clue": {
      "type": "ask",
      "collect": ["charge_date", "amount", "purchase_channel_hint"],
      "prompt": "暂时没有找到匹配订单。请再核对扣款日期、金额或购买渠道。",
      "next": "find_order",
      "max_visits": 2,
      "on_limit": "escalate"
    },
    "route_by_channel": {
      "type": "branch",
      "cases": [
        {"when": "order.channel == 'apple'", "next": "guide_apple"},
        {"when": "order.channel == 'first_party'", "next": "load_refund_facts"}
      ],
      "default": "guide_other_store"
    },
    "load_refund_facts": {
      "type": "action",
      "tool": "get_refund_facts",
      "args": {"order_id": "{{ order.id }}"},
      "requires": ["target_account_verified", "order.id"],
      "on_guard_failure": "find_order",
      "result_statuses": ["success", "error"],
      "transitions": {"success": "assess_eligibility", "error": "escalate"},
      "save_result_as": "refund_facts"
    },
    "assess_eligibility": {
      "type": "action",
      "tool": "evaluate_refund_policy",
      "args": {"order_id": "{{ order.id }}", "refund_facts": "{{ refund_facts }}"},
      "requires": ["refund_facts_loaded"],
      "on_guard_failure": "load_refund_facts",
      "result_statuses": ["eligible", "ineligible", "uncertain", "error"],
      "transitions": {"eligible": "confirm_refund", "ineligible": "explain_ineligible", "uncertain": "escalate", "error": "escalate"},
      "save_result_as": "eligibility_result"
    },
    "confirm_refund": {
      "type": "ask",
      "collect": ["confirm_refund"],
      "prompt": "这笔订单符合退款申请条件。请确认是否提交退款申请。",
      "next": "refund_confirmation_gate"
    },
    "refund_confirmation_gate": {
      "type": "branch",
      "cases": [{"when": "confirm_refund == true", "next": "submit_refund"}],
      "default": "refund_declined"
    },
    "submit_refund": {
      "type": "action",
      "tool": "submit_refund",
      "args": {"order_id": "{{ order.id }}"},
      "requires": ["target_account_verified", "order.id", "refund_eligibility == 'eligible'", "confirm_refund"],
      "on_guard_failure": "escalate",
      "result_statuses": ["submitted", "already_submitted", "error"],
      "transitions": {"submitted": "report_submitted", "already_submitted": "report_already_submitted", "error": "escalate"},
      "save_result_as": "refund_submission",
      "idempotency_key": "{{ case_id }}:refund:{{ order.id }}"
    },
    "explain_ineligible": {
      "type": "respond",
      "template": "根据当前退款规则，这笔订单暂不符合退款条件：{{ refund_reason }}。",
      "next": "done"
    },
    "guide_apple": {
      "type": "respond",
      "template": "这笔订单通过 Apple 购买，需要通过 Apple 的退款流程申请。本系统没有提交退款。",
      "next": "done"
    },
    "guide_other_store": {
      "type": "respond",
      "template": "这笔订单需要通过购买渠道 {{ order.channel }} 申请退款。本系统没有提交退款。",
      "next": "done"
    },
    "refund_declined": {
      "type": "respond",
      "template": "好的，我没有提交退款申请。",
      "next": "done"
    },
    "report_submitted": {
      "type": "respond",
      "template": "退款申请已提交，当前状态为 {{ refund_submission.status }}。这表示申请已受理，不代表款项已到账。",
      "next": "done"
    },
    "report_already_submitted": {
      "type": "respond",
      "template": "系统显示这笔订单已有退款申请，不会重复提交。",
      "next": "done"
    },
    "escalate": {
      "type": "action",
      "tool": "create_handoff",
      "args": {"case_id": "{{ case_id }}"},
      "requires": [],
      "on_guard_failure": "handoff_failed",
      "result_statuses": ["created", "error"],
      "transitions": {"created": "wait_for_human", "error": "handoff_failed"}
    },
    "wait_for_human": {"type": "wait", "event": "human_case_updated"},
    "handoff_failed": {"type": "respond", "template": "暂时无法连接人工客服，请稍后重试。"},
    "done": {"type": "end"}
  }
}
