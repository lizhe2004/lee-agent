{
  "$schema": "../schemas/workflow.schema.json",
  "id": "subscription_cancellation",
  "version": 1,
  "description": "Verify subscription ownership, inspect its provider and disable future renewal when supported.",
  "mutable_inputs": {
    "account_relation": {"type": "string", "enum": ["current", "other"], "on_change": "account_scope", "priority": 0, "invalidates": ["target_account_verified", "account_binding", "identity_result", "subscription", "subscription_lookup"]},
    "purchase_account_phone": {"type": "string", "on_change": "send_otp", "priority": 0, "invalidates": ["target_account_verified", "account_binding", "identity_result", "subscription", "subscription_lookup"]},
    "subscription_hint": {"type": "string", "on_change": "find_subscription", "priority": 10, "invalidates": ["subscription", "subscription_lookup"]},
    "purchase_channel_hint": {"type": "string", "on_change": "find_subscription", "priority": 10, "invalidates": ["subscription", "subscription_lookup"]}
  },
  "start": "collect_subscription_clues",
  "nodes": {
    "collect_subscription_clues": {
      "type": "ask",
      "collect": ["account_relation", "purchase_channel_hint", "subscription_hint", "charge_date"],
      "prompt": "请说明订阅属于当前账号还是其他账号、购买渠道，以及订阅或扣款的大致信息。",
      "next": "account_scope"
    },
    "account_scope": {
      "type": "branch",
      "cases": [{"when": "account_relation == 'current'", "next": "bind_current_account"}],
      "default": "ask_purchase_phone"
    },
    "bind_current_account": {
      "type": "action",
      "tool": "bind_current_account",
      "args": {},
      "requires": ["session.authenticated"],
      "on_guard_failure": "ask_purchase_phone",
      "result_statuses": ["bound", "error"],
      "transitions": {"bound": "find_subscription", "error": "escalate"},
      "save_result_as": "account_binding"
    },
    "ask_purchase_phone": {
      "type": "ask",
      "collect": ["purchase_account_phone"],
      "prompt": "请提供订阅账号绑定的手机号，我会发送验证码验证账号归属。",
      "next": "send_otp",
      "max_visits": 3,
      "on_limit": "escalate"
    },
    "send_otp": {
      "type": "action",
      "tool": "send_otp",
      "args": {"phone": "{{ purchase_account_phone }}"},
      "requires": ["purchase_account_phone"],
      "on_guard_failure": "ask_purchase_phone",
      "result_statuses": ["sent", "rate_limited", "error"],
      "transitions": {"sent": "ask_otp", "rate_limited": "escalate", "error": "escalate"}
    },
    "ask_otp": {
      "type": "ask",
      "collect": ["otp_code"],
      "sensitive_collect": ["otp_code"],
      "prompt": "验证码已发送，请在安全输入区域输入验证码。",
      "next": "verify_otp",
      "max_visits": 3,
      "on_limit": "escalate"
    },
    "verify_otp": {
      "type": "action",
      "tool": "verify_otp",
      "args": {"phone": "{{ purchase_account_phone }}", "code": "{{ otp_code }}"},
      "requires": ["purchase_account_phone", "otp_code"],
      "on_guard_failure": "ask_otp",
      "result_statuses": ["verified", "failed", "expired", "error"],
      "transitions": {"verified": "find_subscription", "failed": "ask_otp", "expired": "ask_otp", "error": "escalate"},
      "save_result_as": "identity_result",
      "consume_facts": ["otp_code"]
    },
    "find_subscription": {
      "type": "action",
      "tool": "find_subscription",
      "args": {"hint": "{{ subscription_hint }}", "channel": "{{ purchase_channel_hint }}"},
      "requires": ["target_account_verified"],
      "on_guard_failure": "verify_otp",
      "result_statuses": ["found", "not_found", "error"],
      "transitions": {"found": "route_by_channel", "not_found": "ask_subscription_hint", "error": "escalate"},
      "save_result_as": "subscription_lookup"
    },
    "ask_subscription_hint": {
      "type": "ask",
      "collect": ["subscription_hint", "purchase_channel_hint"],
      "prompt": "暂时没有找到匹配的订阅。请核对购买渠道或订阅信息。",
      "next": "find_subscription",
      "max_visits": 2,
      "on_limit": "escalate"
    },
    "route_by_channel": {
      "type": "branch",
      "cases": [
        {"when": "subscription.channel == 'first_party'", "next": "confirm_cancel"},
        {"when": "subscription.channel == 'apple'", "next": "guide_apple"},
        {"when": "subscription.channel == 'google_play'", "next": "guide_google_play"}
      ],
      "default": "guide_other_store"
    },
    "confirm_cancel": {
      "type": "ask",
      "collect": ["confirm_cancel"],
      "prompt": "我找到一个由本系统管理的订阅。关闭自动续费后，当前有效期仍可使用。确认关闭吗？",
      "next": "cancellation_confirmation_gate"
    },
    "cancellation_confirmation_gate": {
      "type": "branch",
      "cases": [{"when": "confirm_cancel == true", "next": "cancel_subscription"}],
      "default": "cancel_declined"
    },
    "cancel_subscription": {
      "type": "action",
      "tool": "cancel_subscription",
      "args": {"subscription_id": "{{ subscription.id }}"},
      "requires": ["target_account_verified", "subscription.id", "confirm_cancel"],
      "on_guard_failure": "escalate",
      "result_statuses": ["cancelled", "already_disabled", "error"],
      "transitions": {"cancelled": "report_cancelled", "already_disabled": "report_already_disabled", "error": "escalate"},
      "save_result_as": "cancellation_result",
      "idempotency_key": "{{ case_id }}:cancel:{{ subscription.id }}"
    },
    "guide_apple": {
      "type": "respond",
      "template": "该订阅由 Apple 管理。请在 Apple 账号的订阅设置中关闭续费；本系统无法代为取消。",
      "next": "done"
    },
    "guide_google_play": {
      "type": "respond",
      "template": "该订阅由 Google Play 管理。请在 Google Play 的订阅设置中关闭续费；本系统无法代为取消。",
      "next": "done"
    },
    "guide_other_store": {
      "type": "respond",
      "template": "该订阅需要通过购买渠道 {{ subscription.channel }} 管理。本系统无法代为取消。",
      "next": "done"
    },
    "cancel_declined": {
      "type": "respond",
      "template": "好的，我没有关闭自动续费。",
      "next": "done"
    },
    "report_cancelled": {
      "type": "respond",
      "template": "自动续费已关闭。当前有效期状态：{{ subscription.status }}。这次操作没有提交退款。",
      "next": "done"
    },
    "report_already_disabled": {
      "type": "respond",
      "template": "系统显示该订阅的自动续费已经关闭。此操作没有提交退款。",
      "next": "done"
    },
    "escalate": {
      "type": "action",
      "tool": "create_handoff",
      "args": {"case_id": "{{ case_id }}"},
      "requires": [],
      "on_guard_failure": "handoff_failed",
      "result_statuses": ["created", "error"],
      "transitions": {"created": "wait_for_human", "error": "handoff_failed"}
    },
    "wait_for_human": {"type": "wait", "event": "human_case_updated"},
    "handoff_failed": {"type": "respond", "template": "暂时无法连接人工客服，请稍后重试。"},
    "done": {"type": "end"}
  }
}
